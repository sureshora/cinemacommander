# HACK-CINE-001
# Google Cloud / Gemini values will be activated in HACK-CINE-002.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Parallel Search will be activated in HACK-CINE-005.
PARALLEL_API_KEY=

# Application
APP_ENV=development
APP_NAME=Cinema Commander
